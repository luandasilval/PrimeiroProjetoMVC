@model List<Aluno>
@{
    ViewData["Title"] = "Listagem de alunos";
}

<H1>Listagem geral de alunos</H1>
<table>
    <tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Email</th>
        <th>Idade</th>
        <th></th>
    </tr>
    @foreach (Aluno aluno in Model)
    {
        <tr>
            <td>@aluno.Id</td>
            <td>@aluno.Nome</td>
            <td>@aluno.Email</td>
            <td>@aluno.Idade</td>
            <td>
                <a asp-action="Detalhes" asp-route-id="@aluno.Id">Ver</a>
            </td>
        </tr>
    }
</table>